%lh
%xh<%= title %>%xn
<% if sheet[:class_name] %>
%xb<%= sheet[:class_name] %>%xn (<%= sheet[:race] %>) - Level <%= sheet[:level] %>
Alignment: <%= sheet[:alignment] %>
HP: <%= sheet[:hp] %>/<%= sheet[:hp_max] %>  THAC0: <%= sheet[:thac0] %>  HD: <%= sheet[:hd_display] %>
XP: <%= sheet[:xp] %> (<%= sheet[:xp_bonus] %>% bonus)  Gold: <%= sheet[:starting_gold] %> gp
<% sheet[:abilities].each do |a| %>
<%= a[:name] %> <%= a[:score] %> (<%= a[:modifier] >= 0 ? '+' : '' %><%= a[:modifier] %>)
<% end %>
<% if sheet[:saves] && !sheet[:saves].empty? %>
Saves: Death <%= sheet[:saves]['death'] %>, Wands <%= sheet[:saves]['wands'] %>, Para <%= sheet[:saves]['paralysis'] %>, Breath <%= sheet[:saves]['breath'] %>, Spells <%= sheet[:saves]['spells'] %>
<% end %>
<% if sheet[:spell_slots] && !sheet[:spell_slots].empty? %>
Spell Slots: <% sheet[:spell_slots].each do |lvl, n| %>L<%= lvl %>:<%= n %> <% end %>
<% end %>
<% if sheet[:thief_skills] && !sheet[:thief_skills].empty? %>
Skills: <% sheet[:thief_skills].each do |sk| %><%= sk[:name] %> <%= sk[:chance] %><% end %>
<% end %>
<% else %>
No OSE sheet configured.
<% end %>
%lf
