<div id="systemrpg" class="tab-pane fade">
  <div class="tab-cover">OSR Sheet</div>

  {{#if this.sheet.class_name}}
    <h4>{{this.sheet.class_name}} ({{this.sheet.race}})</h4>
    <p>Level {{this.sheet.level}} | Alignment: {{this.sheet.alignment}}</p>
    <p>HP: {{this.sheet.hp}}/{{this.sheet.hp_max}} | THAC0: {{this.sheet.thac0}} | HD: {{this.sheet.hd_display}}</p>
    <p>XP: {{this.sheet.xp}}{{#if this.sheet.xp_to_next_level}} (next level at {{this.sheet.xp_to_next_level}}){{/if}} ({{this.sheet.xp_bonus}}% bonus) | Gold: {{this.sheet.starting_gold}} gp</p>

    {{#if this.isOwnProfile}}
      <div class="osr-rpg-leveling-bar">
        {{#if this.sheet.can_level_up}}
          <button type="button" class="btn btn-sm btn-primary" disabled={{this.isLeveling}} {{on 'click' this.levelUp}}>
            {{if this.isLeveling 'Leveling…' 'Level Up'}}
          </button>
        {{else if this.sheet.xp_to_next_level}}
          <span class="text-muted">Need {{this.sheet.xp_to_next_level}} XP for next level.</span>
        {{/if}}
        {{#if (gt this.sheet.expertise_unspent 0)}}
          <span class="osr-rpg-pool-chip">{{this.sheet.expertise_unspent}} expertise unspent — use <code>osr_rpg/skills</code></span>
        {{/if}}
      </div>
    {{/if}}

    {{#if this.sheet.abilities}}
      <p>
        {{#each this.sheet.abilities as |ab|}}
          <b>{{ab.name}}</b> {{ab.score}} ({{#if (gte ab.modifier 0)}}+{{/if}}{{ab.modifier}}){{#unless @last}} | {{/unless}}
        {{/each}}
      </p>
    {{/if}}

    {{#if this.sheet.saves}}
      <p>Saves: D{{this.sheet.saves.death}} W{{this.sheet.saves.wands}} P{{this.sheet.saves.paralysis}} B{{this.sheet.saves.breath}} S{{this.sheet.saves.spells}}</p>
    {{/if}}

    {{#if this.sheet.spell_slots}}
      <p>Spell Slots:
        {{#each-in this.sheet.spell_slots as |lvl count|}}
          L{{lvl}}:{{count}}
        {{/each-in}}
      </p>
    {{/if}}

    {{#if (eq this.sheet.casting_type "divine")}}
      <p>Spells: Full {{this.sheet.spell_tradition}} list access</p>
    {{/if}}

    {{#if this.sheet.spell_book}}
      {{#each-in this.sheet.spell_book as |lvl spells|}}
        {{#if (eq lvl "1")}}
          {{#if (eq this.sheet.casting_type "arcane")}}
            <p>Spell Book L1:
              {{#each spells as |spell|}}
                {{spell}}{{#unless @last}}, {{/unless}}
              {{/each}}
            </p>
          {{/if}}
          {{#if (eq this.sheet.casting_type "restricted")}}
            <p>L1 Spell:
              {{#each spells as |spell|}}
                {{spell}}{{#unless @last}}, {{/unless}}
              {{/each}}
            </p>
          {{/if}}
        {{/if}}
      {{/each-in}}
    {{/if}}

    {{#if (gt this.sheet.expertise_unspent 0)}}
      <p>Skill expertise unspent: {{this.sheet.expertise_unspent}}</p>
    {{/if}}

    {{#if this.sheet.thief_skills}}
      <p>Skills:
        {{#each this.sheet.thief_skills as |sk|}}
          {{sk.name}} {{sk.chance}}{{#unless @last}}, {{/unless}}
        {{/each}}
      </p>
    {{/if}}

    {{#if this.sheet.playtest}}
      <p class="text-warning"><i>Playtest class</i></p>
    {{/if}}
  {{else}}
    <p><i>No OSR sheet configured.</i></p>
  {{/if}}
</div>
