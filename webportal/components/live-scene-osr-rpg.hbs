<li><button {{on 'click' this.showCharacterCard}} class="dropdown-item">Character Sheet</button></li>
<li><button {{on 'click' (fn this.setShowGenericRoll true)}} class="dropdown-item">Roll Dice</button></li>
<li><button {{on 'click' (fn this.setShowAttackRoll true)}} class="dropdown-item">Roll Attack</button></li>
<li><button {{on 'click' (fn this.setShowSaveRoll true)}} class="dropdown-item">Roll Save</button></li>
{{#if this.skillOptions.length}}
  <li><button {{on 'click' (fn this.setShowSkillRoll true)}} class="dropdown-item">Roll Skill</button></li>
{{/if}}
<li><button {{on 'click' (fn this.setShowAbilityRoll true)}} class="dropdown-item">Ability Check</button></li>
<li><button {{on 'click' this.toggleCombatTracker}} class="dropdown-item">Combat Tracker</button></li>

{{#if this.showCombatTracker}}
  <div class="osr-rpg-combat-tracker">
    <div class="osr-rpg-combat-toolbar">
      <b>Scene Combat</b>
      {{#if this.combat.active}}
        <button type="button" class="btn btn-sm btn-outline-primary" {{on 'click' this.joinCombat}}>Join</button>
        <button type="button" class="btn btn-sm btn-outline-danger" {{on 'click' this.endCombat}}>End</button>
      {{else}}
        <button type="button" class="btn btn-sm btn-outline-primary" {{on 'click' this.startCombat}}>Start</button>
      {{/if}}
    </div>
    {{#if this.isCombatLoading}}
      <p class="text-muted">Loading…</p>
    {{else}}
      {{#each this.sortedCombatants as |c|}}
        <div class="osr-rpg-combat-row">
          <span class="osr-rpg-combat-name">{{c.name}}</span>
          <span class="osr-rpg-init-badge">Init {{c.initiative}}</span>
          <span>HP {{c.hp}}/{{c.hp_max}}</span>
          <span>AC {{c.ac}}</span>
        </div>
      {{else}}
        <p class="text-muted"><i>No combatants.</i></p>
      {{/each}}
    {{/if}}
  </div>
{{/if}}

<BsModalSimple @title="Roll Attack" @closeTitle="Cancel" @submitTitle="Roll" @open={{this.showAttackRoll}} @onSubmit={{this.rollAttack}} @onHide={{(fn this.setShowAttackRoll false)}}>
  <p>Roll d20 attack using pose character THAC0.</p>
  <p><label>Target AC (optional):</label> <Input @type="number" @value={{this.attackTargetAc}} {{on 'input' this.attackTargetAcChanged}} /></p>
</BsModalSimple>

<BsModalSimple @title="Roll Save" @closeTitle="Cancel" @submitTitle="Roll" @open={{this.showSaveRoll}} @onSubmit={{this.rollSave}} @onHide={{(fn this.setShowSaveRoll false)}}>
  <select class="form-control" {{on 'change' this.saveCategoryChanged}}>
    {{#each this.rollSaveCategories as |cat|}}
      <option value={{cat.key}} selected={{eq this.saveCategory cat.key}}>{{cat.label}}</option>
    {{/each}}
  </select>
</BsModalSimple>

<BsModalSimple @title="Roll Skill" @closeTitle="Cancel" @submitTitle="Roll" @open={{this.showSkillRoll}} @onSubmit={{this.rollSkill}} @onHide={{(fn this.setShowSkillRoll false)}}>
  <select class="form-control" {{on 'change' this.skillKeyChanged}}>
    {{#each this.skillOptions as |sk|}}
      <option value={{sk.key}} selected={{eq this.skillKey sk.key}}>{{sk.name}} ({{sk.chance}})</option>
    {{/each}}
  </select>
</BsModalSimple>

<BsModalSimple @title="Ability Check" @closeTitle="Cancel" @submitTitle="Roll" @open={{this.showAbilityRoll}} @onSubmit={{this.rollAbility}} @onHide={{(fn this.setShowAbilityRoll false)}}>
  <p>
    <select class="form-control" {{on 'change' this.abilityKeyChanged}}>
      <option value="str" selected={{eq this.abilityKey 'str'}}>STR</option>
      <option value="dex" selected={{eq this.abilityKey 'dex'}}>DEX</option>
      <option value="con" selected={{eq this.abilityKey 'con'}}>CON</option>
      <option value="int" selected={{eq this.abilityKey 'int'}}>INT</option>
      <option value="wis" selected={{eq this.abilityKey 'wis'}}>WIS</option>
      <option value="cha" selected={{eq this.abilityKey 'cha'}}>CHA</option>
    </select>
  </p>
  <p><label>Target (optional):</label> <Input @type="number" @value={{this.abilityTarget}} {{on 'input' this.abilityTargetChanged}} /></p>
</BsModalSimple>

<BsModalSimple @title="Roll Dice" @closeTitle="Cancel" @submitTitle="Roll" @open={{this.showGenericRoll}} @onSubmit={{this.rollGeneric}} @onHide={{this.hideGenericRoll}}>
  <div class="osr-rpg-scene-dice-tray">
    <div class="osr-rpg-scene-dice-grid">
      {{#each this.diceTypes as |sides|}}
        <div class="osr-rpg-scene-die-tile">
          <div class="osr-rpg-scene-die-label">d{{sides}}</div>
          <div class="osr-rpg-scene-die-controls">
            <button type="button" class="btn btn-sm btn-outline-secondary osr-rpg-scene-die-btn" disabled={{eq (get this.diceCounts sides) 0}} {{on 'click' (fn this.removeDie sides)}} aria-label="Remove d{{sides}}">−</button>
            <span class="osr-rpg-scene-die-count">{{get this.diceCounts sides}}</span>
            <button type="button" class="btn btn-sm btn-outline-secondary osr-rpg-scene-die-btn" disabled={{gte (get this.diceCounts sides) 10}} {{on 'click' (fn this.addDie sides)}} aria-label="Add d{{sides}}">+</button>
          </div>
        </div>
      {{/each}}
    </div>

    <div class="osr-rpg-scene-dice-pool">
      {{#if this.hasDicePool}}
        <span class="osr-rpg-pool-chip osr-rpg-scene-dice-pool-chip">{{this.dicePoolDisplay}}</span>
        <button type="button" class="btn btn-link btn-sm osr-rpg-scene-dice-clear" {{on 'click' this.clearDicePoolAction}}>Clear all</button>
      {{else}}
        <span class="text-muted osr-rpg-scene-dice-pool-empty">Tap + to add dice to your roll.</span>
      {{/if}}
    </div>
  </div>
</BsModalSimple>
